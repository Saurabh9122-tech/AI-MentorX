# AI MentorX Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to Git

# ── Required ──────────────────────────────────────────────────────────────────
# Google Gemini API Key (free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# AI Provider: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# OpenAI API Key (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# SQLite database file path (default: mentorx.db in project root)
DB_PATH=mentorx.db
